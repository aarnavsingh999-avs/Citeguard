# CiteGuard AI - Environment Configuration Example
# Copy this file to .env and insert your personal API keys
# NOTE: Never commit your actual .env file to version control.

# Google Gemini API Key (Optional: system automatically falls back to deterministic local engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Retriever Settings
RETRIEVER_TOP_K=3
SIMILARITY_THRESHOLD=0.15

# University Metadata (Exact values for Milestone 2)
PROJECT_TITLE=Campus Helpdesk Assistant
TEAM_ID=[TEAM_ID]
TEAM_NAME=CiteGuard AI
BATCH=[YOUR_BATCH]
FACULTY_NAME=[YOUR_FACULTY_NAME]
DEVELOPER_NAME=Aarnav Singh
DEVELOPER_ENROLLMENT=S24CSEU1498
DEVELOPER_CONTRIBUTION=100%
